{
  "name": "kataribe",
  "version": "0.1.0",
  "description": "会議音声の録音、文字起こし、要約を行う macOS アプリ",
  "main": "./out/main/index.js",
  "author": "Shoichi Furuya",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icons": "node scripts/build-icons.cjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "npm run build && KATARIBE_SMOKE_TEST=1 electron .",
    "test:window": "npm run build && KATARIBE_WINDOW_TEST=1 electron .",
    "package": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac dmg",
    "verify:mac": "node scripts/verify-mac-bundle.cjs",
    "verify:mac:release": "node scripts/verify-mac-bundle.cjs --strict-signing",
    "binaries": "bash scripts/build-binaries.sh"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
